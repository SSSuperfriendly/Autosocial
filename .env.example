DATABASE_PATH=data/autosocial.db

# Local-only development can leave the password blank.
# Docker / public hosting requires a random password of at least 12 characters.
# Public HTTPS URL when using a reverse proxy (no path), e.g. https://apply.example.com
AUTOSOCIAL_PUBLIC_ORIGIN=
AUTOSOCIAL_USERNAME=autosocial
AUTOSOCIAL_PASSWORD=
AUTOSOCIAL_REQUIRE_AUTH=false
# Comma-separated exact origins for a separate development frontend.
AUTOSOCIAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

OPENAI_SEARCH_API_KEY=
OPENAI_SEARCH_BASE_URL=https://api.openai.com/v1
OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview

BIGMODEL_SEARCH_API_KEY=
BIGMODEL_SEARCH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_SEARCH_MODEL=glm-4-air
BIGMODEL_SEARCH_ENGINE=search_pro

# Optional authorized faculty-directory API access. Blank uses ordinary HTML crawling.
ZJU_PERSON_APP_KEY=
ZJU_PERSON_SECRET=
ZJU_PERSON_COLLEGE_IDS=

SENDER_NAME=
SENDER_EMAIL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
FORCE_TEST_RECIPIENT=false
TEST_RECIPIENT_DRY_RUN_ONLY=false
TEST_RECIPIENT_EMAIL=

IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

ATTACHMENT_DIR=data/attachments

HTTP_TIMEOUT_SECONDS=20
USER_AGENT=AutoSocial/0.1
